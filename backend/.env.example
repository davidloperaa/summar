# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@host:5432/summar_db

# JWT — genera un string aleatorio largo para producción
JWT_SECRET=cambia_esto_por_un_string_aleatorio_largo_y_seguro
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000
NODE_ENV=development

# CORS — URL del frontend en producción
FRONTEND_URL=https://summar-productividad.netlify.app
